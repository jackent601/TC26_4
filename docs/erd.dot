// Accommodation allocation PoC v2: ER diagram source.
// Keep in line with src/db/migrations/0001_schema.sql. Rebuild the images with docs/build_erd.sh
digraph ERD {
  graph [rankdir=LR, fontname="Helvetica,sans-Serif", fontsize=22, labelloc=t, pad=0.4, nodesep=0.4, ranksep=0.9,
         label=<<b>Accommodation allocation PoC v2: entity relationship diagram</b>>];
  node  [shape=plain, fontname="Helvetica,sans-Serif", fontsize=11];
  edge  [color="#555555", fontname="Helvetica,sans-Serif", fontsize=9, fontcolor="#555555", arrowhead=none, arrowtail=crow, dir=both];
  // Edges read child -> parent; the crow's foot sits on the child (many) side.
  subgraph cluster_supply {
    label=<<b>Supply</b>>; fontsize=16; style="rounded,filled"; fillcolor="#eaf2fb"; color="#2f6db5"; fontcolor="#2f6db5";
    sites [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>SITES</b></font></td></tr><tr><td align="left" bgcolor="white" port="site_id_l">site_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="site_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="sort_order_l">sort_order</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="sort_order_r" bgcolor="white"> </td></tr></table>>];
    buildings [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>BUILDINGS</b></font></td></tr><tr><td align="left" bgcolor="white" port="building_id_l">building_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="building_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="site_id_l">site_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="site_id_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK in site</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="sort_order_l">sort_order</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="sort_order_r" bgcolor="white"> </td></tr></table>>];
    blocks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>BLOCKS</b></font></td></tr><tr><td align="left" bgcolor="white" port="block_id_l">block_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="block_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="building_id_l">building_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="building_id_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK in building</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="sort_order_l">sort_order</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="sort_order_r" bgcolor="white"> </td></tr></table>>];
    floors [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>FLOORS</b></font></td></tr><tr><td align="left" bgcolor="white" port="floor_id_l">floor_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="floor_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="block_id_l">block_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="block_id_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK in block</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="sort_order_l">sort_order</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="sort_order_r" bgcolor="white"> </td></tr></table>>];
    rooms [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>ROOMS</b></font></td></tr><tr><td align="left" bgcolor="white" port="room_id_l">room_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="room_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="floor_id_l">floor_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="floor_id_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK in floor</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="sort_order_l">sort_order</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="sort_order_r" bgcolor="white"> </td></tr></table>>];
    beds [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>BEDS</b></font></td></tr><tr><td align="left" bgcolor="white" port="bed_id_l">bed_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="bed_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="room_id_l">room_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="room_id_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2f6db5">UK in room</font></td></tr></table>>];
    locattr [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2f6db5"><tr><td colspan="3" bgcolor="#2f6db5"><font color="white"><b>LOCATION_ATTRIBUTES</b></font></td></tr><tr><td align="left" bgcolor="white" port="loc_attr_id_l">loc_attr_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="loc_attr_id_r" bgcolor="white"><font color="#2f6db5">PK</font></td></tr><tr><td align="left" bgcolor="white" port="attr_code_l">attr_code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_code_r" bgcolor="white"><font color="#2f6db5">FK</font></td></tr><tr><td align="left" bgcolor="white" port="attr_value_l">attr_value</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_value_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="valid_from_l">valid_from</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="valid_from_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="valid_to_l">valid_to</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="valid_to_r" bgcolor="white"><font color="#2f6db5">exclusive</font></td></tr><tr><td align="left" bgcolor="white" port="comments_l">comments</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="comments_r" bgcolor="white"><font color="#2f6db5">outage reason</font></td></tr><tr><td align="left" bgcolor="white" port="levels_l">site_id … bed_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="levels_r" bgcolor="white"><font color="#2f6db5">FK, exactly one set</font></td></tr></table>>];
  }
  subgraph cluster_vocab {
    label=<<b>Vocabulary and rules</b>>; fontsize=16; style="rounded,filled"; fillcolor="#f3eefb"; color="#6b4fa8"; fontcolor="#6b4fa8";
    attrtypes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#6b4fa8"><tr><td colspan="3" bgcolor="#6b4fa8"><font color="white"><b>ATTRIBUTE_TYPES</b></font></td></tr><tr><td align="left" bgcolor="white" port="attr_code_l">attr_code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_code_r" bgcolor="white"><font color="#6b4fa8">PK</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="description_l">description</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="description_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="applies_to_l">applies_to</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="applies_to_r" bgcolor="white"><font color="#6b4fa8">LOCATION | INDIVIDUAL | BOTH</font></td></tr><tr><td align="left" bgcolor="white" port="data_type_l">data_type</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="data_type_r" bgcolor="white"><font color="#6b4fa8">TEXT | NUMBER | FLAG</font></td></tr><tr><td align="left" bgcolor="white" port="inherit_mode_l">inherit_mode</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="inherit_mode_r" bgcolor="white"><font color="#6b4fa8">NEAREST | ANY</font></td></tr><tr><td align="left" bgcolor="white" port="allow_overlap_l">allow_overlap</td><td align="left" bgcolor="white"><font color="#555555">char</font></td><td align="left" port="allow_overlap_r" bgcolor="white"><font color="#6b4fa8">Y | N</font></td></tr><tr><td align="left" bgcolor="white" port="comment_required_l">comment_required</td><td align="left" bgcolor="white"><font color="#555555">char</font></td><td align="left" port="comment_required_r" bgcolor="white"><font color="#6b4fa8">Y | N</font></td></tr></table>>];
    rules [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#6b4fa8"><tr><td colspan="3" bgcolor="#6b4fa8"><font color="white"><b>RULES</b></font></td></tr><tr><td align="left" bgcolor="white" port="rule_code_l">rule_code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="rule_code_r" bgcolor="white"><font color="#6b4fa8">PK</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="rule_type_l">rule_type</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="rule_type_r" bgcolor="white"><font color="#6b4fa8">COMPARE | REQUIRES | MATCH_WITHIN | SOLE_USE | LOCATION_BLOCKS</font></td></tr><tr><td align="left" bgcolor="white" port="individual_attr_l">individual_attr</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="individual_attr_r" bgcolor="white"><font color="#6b4fa8">FK</font></td></tr><tr><td align="left" bgcolor="white" port="location_attr_l">location_attr</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="location_attr_r" bgcolor="white"><font color="#6b4fa8">FK</font></td></tr><tr><td align="left" bgcolor="white" port="operator_l">operator</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="operator_r" bgcolor="white"><font color="#6b4fa8">&gt;= | &lt;= | =</font></td></tr><tr><td align="left" bgcolor="white" port="scope_l">scope</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="scope_r" bgcolor="white"><font color="#6b4fa8">ROOM | FLOOR | BLOCK</font></td></tr><tr><td align="left" bgcolor="white" port="severity_l">severity</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="severity_r" bgcolor="white"><font color="#6b4fa8">BLOCK | WARNING | INFO</font></td></tr><tr><td align="left" bgcolor="white" port="active_l">active</td><td align="left" bgcolor="white"><font color="#555555">char</font></td><td align="left" port="active_r" bgcolor="white"><font color="#6b4fa8">Y | N</font></td></tr><tr><td align="left" bgcolor="white" port="message_l">message</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="message_r" bgcolor="white"> </td></tr></table>>];
  }
  subgraph cluster_demand {
    label=<<b>Demand</b>>; fontsize=16; style="rounded,filled"; fillcolor="#eaf6ea"; color="#2e8b57"; fontcolor="#2e8b57";
    courses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2e8b57"><tr><td colspan="3" bgcolor="#2e8b57"><font color="white"><b>COURSES</b></font></td></tr><tr><td align="left" bgcolor="white" port="course_id_l">course_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="course_id_r" bgcolor="white"><font color="#2e8b57">PK</font></td></tr><tr><td align="left" bgcolor="white" port="code_l">code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="code_r" bgcolor="white"><font color="#2e8b57">UK</font></td></tr><tr><td align="left" bgcolor="white" port="name_l">name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="site_id_l">site_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="site_id_r" bgcolor="white"><font color="#2e8b57">FK, optional</font></td></tr><tr><td align="left" bgcolor="white" port="start_date_l">start_date</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="start_date_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="end_date_l">end_date</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="end_date_r" bgcolor="white"><font color="#2e8b57">exclusive</font></td></tr><tr><td align="left" bgcolor="white" port="scheduled_l">scheduled</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="scheduled_r" bgcolor="white"><font color="#2e8b57">planned attendees</font></td></tr><tr><td align="left" bgcolor="white" port="loaded_l">loaded</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="loaded_r" bgcolor="white"><font color="#2e8b57">registered attendees</font></td></tr><tr><td align="left" bgcolor="white" port="loaded_at_l">loaded_at</td><td align="left" bgcolor="white"><font color="#555555">timestamp</font></td><td align="left" port="loaded_at_r" bgcolor="white"><font color="#2e8b57">when loaded updated</font></td></tr><tr><td align="left" bgcolor="white" port="status_l">status</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="status_r" bgcolor="white"><font color="#2e8b57">REQUESTED | CONFIRMED | CANCELLED</font></td></tr><tr><td align="left" bgcolor="white" port="notes_l">notes</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="notes_r" bgcolor="white"> </td></tr></table>>];
    courseattr [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2e8b57"><tr><td colspan="3" bgcolor="#2e8b57"><font color="white"><b>COURSE_ATTRIBUTES</b></font></td></tr><tr><td align="left" bgcolor="white" port="course_id_l">course_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="course_id_r" bgcolor="white"><font color="#2e8b57">PK, FK</font></td></tr><tr><td align="left" bgcolor="white" port="attr_code_l">attr_code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_code_r" bgcolor="white"><font color="#2e8b57">PK, FK</font></td></tr><tr><td align="left" bgcolor="white" port="attr_value_l">attr_value</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_value_r" bgcolor="white"><font color="#2e8b57">default for every individual</font></td></tr></table>>];
    courseindattr [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2e8b57"><tr><td colspan="3" bgcolor="#2e8b57"><font color="white"><b>COURSE_INDIVIDUAL_ATTRIBUTES</b></font></td></tr><tr><td align="left" bgcolor="white" port="course_id_l">course_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="course_id_r" bgcolor="white"><font color="#2e8b57">PK, FK</font></td></tr><tr><td align="left" bgcolor="white" port="individual_no_l">individual_no</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="individual_no_r" bgcolor="white"><font color="#2e8b57">PK, 1..greatest(scheduled, loaded)</font></td></tr><tr><td align="left" bgcolor="white" port="attr_code_l">attr_code</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_code_r" bgcolor="white"><font color="#2e8b57">PK, FK</font></td></tr><tr><td align="left" bgcolor="white" port="attr_value_l">attr_value</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="attr_value_r" bgcolor="white"><font color="#2e8b57">overrides course default</font></td></tr></table>>];
  }
  subgraph cluster_alloc {
    label=<<b>Allocation</b>>; fontsize=16; style="rounded,filled"; fillcolor="#fcf1e6"; color="#b45309"; fontcolor="#b45309";
    allocations [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#b45309"><tr><td colspan="3" bgcolor="#b45309"><font color="white"><b>ALLOCATIONS</b></font></td></tr><tr><td align="left" bgcolor="white" port="allocation_id_l">allocation_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="allocation_id_r" bgcolor="white"><font color="#b45309">PK</font></td></tr><tr><td align="left" bgcolor="white" port="course_id_l">course_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="course_id_r" bgcolor="white"><font color="#b45309">FK, null = external</font></td></tr><tr><td align="left" bgcolor="white" port="individual_no_l">individual_no</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="individual_no_r" bgcolor="white"><font color="#b45309">not a FK</font></td></tr><tr><td align="left" bgcolor="white" port="bed_id_l">bed_id</td><td align="left" bgcolor="white"><font color="#555555">int</font></td><td align="left" port="bed_id_r" bgcolor="white"><font color="#b45309">FK</font></td></tr><tr><td align="left" bgcolor="white" port="start_date_l">start_date</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="start_date_r" bgcolor="white"><font color="#b45309">first night</font></td></tr><tr><td align="left" bgcolor="white" port="end_date_l">end_date</td><td align="left" bgcolor="white"><font color="#555555">date</font></td><td align="left" port="end_date_r" bgcolor="white"><font color="#b45309">departure, exclusive</font></td></tr><tr><td align="left" bgcolor="white" port="status_l">status</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="status_r" bgcolor="white"><font color="#b45309">ALLOCATED … CHECKED_OUT | NO_SHOW | CANCELLED</font></td></tr><tr><td align="left" bgcolor="white" port="checked_in_at_l">checked_in_at</td><td align="left" bgcolor="white"><font color="#555555">timestamp</font></td><td align="left" port="checked_in_at_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="checked_out_at_l">checked_out_at</td><td align="left" bgcolor="white"><font color="#555555">timestamp</font></td><td align="left" port="checked_out_at_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="source_l">source</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="source_r" bgcolor="white"><font color="#b45309">LOCAL | EXTERNAL</font></td></tr><tr><td align="left" bgcolor="white" port="external_ref_l">external_ref</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="external_ref_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="external_name_l">external_name</td><td align="left" bgcolor="white"><font color="#555555">varchar</font></td><td align="left" port="external_name_r" bgcolor="white"> </td></tr><tr><td align="left" bgcolor="white" port="created_at_l">created_at</td><td align="left" bgcolor="white"><font color="#555555">timestamp</font></td><td align="left" port="created_at_r" bgcolor="white"> </td></tr></table>>];
  }
  subgraph cluster_audit {
    label=<<b>Audit (standalone, no foreign keys)</b>>; fontsize=16; style="rounded,filled"; fillcolor="#f0f0f0"; color="#555555"; fontcolor="#555555";
