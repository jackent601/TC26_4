# Serves the built UI and forwards /api/* to PostgREST (decision I6).
{
	# No admin API: config only changes by rebuilding the image.
	admin off
}

:8080 {
	# gzip only: zstd came through undecoded on some networks (garbled page).
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# /api/health -> http://api:3000/health
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Vite puts hashed file names under /assets, so they can be cached for good.
		# Everything else (index.html under any path) is checked on every load.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"
		# Unknown paths (e.g. /availability) get the app, which routes them itself.
		try_files {path} /index.html
		file_server
	}
}
