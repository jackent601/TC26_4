# Copy to .env and change the passwords. .env is not committed.
POSTGRES_DB=accomm
POSTGRES_USER=accomm_owner
POSTGRES_PASSWORD=change-me
# Password the API service uses to connect as api_user (api schema only).
API_DB_PASSWORD=change-me-too
# Host port for the API in local dev (compose.override.yaml), and the URL
# browsers use to reach it (used in the API's OpenAPI document and the docs page).
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
# Host port for the browsable API docs in local dev.
API_DOCS_PORT=8081
# Host port for connecting to the database in local dev (compose.override.yaml).
# Change it if something else on your machine already uses 5432.
POSTGRES_PORT=5432
