# Copy to .env and change the passwords. .env is not committed.
POSTGRES_DB=accomm
POSTGRES_USER=accomm_owner
POSTGRES_PASSWORD=change-me
# Password the API service uses to connect as api_user (api schema only).
API_DB_PASSWORD=change-me-too
# Tenant used when a request doesn't send X-Tenant (leave empty for none).
DEFAULT_TENANT=
# Host port for the API in local dev (compose.override.yaml).
API_PORT=8000
# Host port for connecting to the database in local dev (compose.override.yaml).
# Change it if something else on your machine already uses 5432.
POSTGRES_PORT=5432
